# Dépendances
node_modules/

# Build
dist/

# Journaux et fichiers système
*.log
.DS_Store

# Moteur d'images : environnement Python dédié, reconstruit à la demande
# depuis « Modèles » (≈ 2 Go de dépendances MLX).
.venv-images/

# Recherche web : environnement Python de l'instance SearXNG locale,
# réinstallable depuis « Réglages ».
.venv-searx/

# Node.js récupéré par le lanceur quand la machine n'en a pas.
# Se retélécharge tout seul ; ne doit jamais partir dans le dépôt.
.runtime/

# Réglages locaux d'éditeur et d'outils
.vscode/
.idea/
.claude/
tsconfig.tsbuildinfo

# Cache Python du worker d'images
__pycache__/
*.pyc

# Journal de travail : notes personnelles, hors du dépôt public.
PLAN.md
